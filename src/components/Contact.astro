---
import ContactForm from './ContactForm.tsx';
import { site } from '@/data/site';
---

<section id="contato" class="contact" aria-labelledby="contact-title">
  <div class="container"><div class="contact__panel">
    <div class="contact__intro"><header class="contact__head">
      
      <h2 id="contact-title" class="contact__title">
        Vamos conversar?
      </h2>
      <p class="contact__lede">
        Conta um pouco do projeto. Em 3h úteis você recebe um retorno com primeiras perguntas e uma estimativa de prazo.
      </p>
    </header>


      <aside class="contact__side">
        <div class="contact__block">
          <span class="mono contact__block-label">whatsapp</span>
          <a href={`https://wa.me/${site.whatsapp}`} class="contact__block-value link-underline" target="_blank" rel="noopener">
            {site.whatsappLabel}
          </a>
        </div>
        <div class="contact__block">
          <span class="mono contact__block-label">email</span>
          <a href={`mailto:${site.email}`} class="contact__block-value link-underline">
            {site.email}
          </a>
        </div>
        <div class="contact__block">
          <span class="mono contact__block-label">localização</span>
          <span class="contact__block-value">{site.location}</span>
        </div>
        <div class="contact__block">
          <span class="mono contact__block-label">horário</span>
          <span class="contact__block-value">Seg–Sex · 9h às 19h (BRT)</span>
        </div>
      </aside></div>

      <div class="contact__form-wrap">
        <ContactForm client:load whatsapp={site.whatsapp} />
      </div>
    </div>
  </div>
</section>


