---
import type { ProjectPreview } from '@/data/site';

interface Props {
  preview: ProjectPreview;
  url?: string;
  slug: string;
  /** Altura da tela do mock em desktop. */
  height?: string;
}

const { preview, url, slug, height = '520px' } = Astro.props;
const t = preview.theme;
const styleVars = [
  `--m-paper:${t.paper}`,
  `--m-ink:${t.ink}`,
  `--m-accent:${t.accent}`,
  `--m-hero-from:${t.heroFrom}`,
  `--m-hero-to:${t.heroTo}`,
  `--m-card:${t.card}`,
  `--m-screen-h:${height}`,
].join(';');
---

<div class="mock" style={styleVars}>
  <div class="mock__bar">
    <div class="mock__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="mock__url mono">
      {url ?? `https://${slug}.com.br`}
    </div>
  </div>
  <div class="mock__screen">
    <div class="mock__nav">
      <span class="mock__logo">{preview.logo}</span>
      <div class="mock__nav-links">
        {preview.nav.map((n) => <span>{n}</span>)}
      </div>
      <span class="mock__cta-pill">{preview.cta}</span>
    </div>
    <div class="mock__hero">
      <p class="mock__eyebrow">{preview.eyebrow}</p>
      <h2 class="mock__h1">
        {preview.titleBefore} <em>{preview.titleEm}</em>{preview.titleAfter ? ` ${preview.titleAfter}` : ''}
      </h2>
      <p class="mock__sub">{preview.sub}</p>
      <div class="mock__actions">
        <span class="mock__btn-primary">{preview.primary}</span>
        <span class="mock__btn-ghost">{preview.ghost}</span>
      </div>
    </div>
    <div class="mock__cards">
      {preview.cards.map((c, i) => (
        <div class:list={['mock__card', i === 0 && 'mock__card--featured']}>
          <span class="mock__card-tag">{c.tag}</span>
          <p class="mock__card-title">{c.title}</p>
          <p class="mock__card-meta">{c.meta}</p>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .mock {
    border: 1px solid var(--rule);
    border-radius: 16px;
    overflow: hidden;
    background: var(--m-paper);
  }

  .mock__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.625rem 1rem;
    background: var(--paper-shade);
    border-bottom: 1px solid var(--rule);
  }

  .mock__dots { display: flex; gap: 5px; flex-shrink: 0; }

  .mock__dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
  }

  .mock__dots span:nth-child(1) { background: #ff5f57; }
  .mock__dots span:nth-child(2) { background: #febc2e; }
  .mock__dots span:nth-child(3) { background: #28c840; }

  .mock__url {
    flex: 1;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--rule);
    padding: 0.25rem 0.625rem;
    font-size: 0.6875rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    border-radius: 3px;
  }

  .mock__screen {
    overflow: hidden;
    min-height: 300px;
    background: var(--m-paper);
    font-family: var(--font-body);
  }

  .mock__nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: color-mix(in srgb, var(--m-paper) 90%, transparent);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .mock__logo {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--m-ink);
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .mock__nav-links {
    display: flex;
    gap: 0.875rem;
    color: color-mix(in srgb, var(--m-ink) 65%, transparent);
    font-size: 0.75rem;
    flex: 1;
  }

  .mock__cta-pill {
    background: var(--m-ink);
    color: var(--m-paper);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  .mock__hero {
    padding: 2rem 1.5rem 1.5rem;
    background: linear-gradient(180deg, var(--m-hero-from) 0%, var(--m-hero-to) 100%);
  }

  .mock__eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--m-ink) 50%, transparent);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .mock__h1 {
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: clamp(1.5rem, 3.2vw, 2.75rem);
    line-height: 1.2;
    color: var(--m-ink);
    letter-spacing: -0.02em;
    font-weight: 400;
    margin-bottom: 0.625rem;
    max-width: 26ch;
  }

  .mock__h1 em { font-style: italic; color: var(--m-accent); }

  .mock__sub {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--m-ink) 60%, transparent);
    line-height: 1.5;
    max-width: 46ch;
    margin-bottom: 0.875rem;
  }

  .mock__actions { display: flex; gap: 0.5rem; }

  .mock__btn-primary {
    background: var(--m-ink);
    color: var(--m-paper);
    padding: 0.3rem 0.75rem;
    font-size: 0.6875rem;
    border-radius: 999px;
  }

  .mock__btn-ghost {
    border: 1px solid color-mix(in srgb, var(--m-ink) 30%, transparent);
    color: var(--m-ink);
    padding: 0.3rem 0.75rem;
    font-size: 0.6875rem;
    border-radius: 999px;
  }

  .mock__cards {
    padding: 1rem 1.5rem;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 0.625rem;
  }

  .mock__card {
    background: var(--m-card);
    border: 1px solid color-mix(in srgb, var(--m-ink) 10%, transparent);
    border-radius: 4px;
    padding: 0.625rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .mock__card--featured {
    background: var(--m-ink);
    color: var(--m-paper);
    border-color: transparent;
  }

  .mock__card-tag {
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.6;
    font-family: var(--font-mono);
  }

  .mock__card-title {
    font-size: 0.75rem;
    line-height: 1.4;
    font-weight: 500;
  }

  .mock__card--featured .mock__card-title { color: var(--m-paper); }

  .mock__card-meta {
    font-size: 0.625rem;
    opacity: 0.5;
    margin-top: auto;
    font-family: var(--font-mono);
  }

  @media (max-width: 960px) {
    .mock__screen { min-height: 280px; }
  }
  @media (max-width: 600px) {
    .mock__nav { padding: 1rem; gap: .5rem; justify-content: space-between; }
    .mock__nav-links { display: none; }
    .mock__hero { padding: 1.5rem 1rem; }
    .mock__cards { grid-template-columns: 1fr; padding: 1rem; }
    .mock__card { padding: .875rem; }
  }
</style>
