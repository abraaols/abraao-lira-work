# Apps Script Web App URL que recebe o lead e grava no Google Sheets
# Gere essa URL no Apps Script conforme explicado no README.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec

# CallMeBot — notificação gratuita no WhatsApp
# Número comercial com DDI, sem +, espaços ou hífens.
CALLMEBOT_PHONE=5515981194064

# Chave recebida pelo CallMeBot.
# Não coloque a chave real neste arquivo se o repositório for público.
CALLMEBOT_API_KEY=SUA_API_KEY_AQUI
